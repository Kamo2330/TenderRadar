# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave unset for local SQLite, or use PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/tenderradar

# CORS — comma-separated origins for the Next.js frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
